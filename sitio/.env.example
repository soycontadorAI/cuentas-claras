# Copiar a .env para probar los formularios en local. Sin estas variables, en `pnpm dev` los
# formularios responden "simulado" y no envían nada; en producción responden 503 con el WhatsApp.

# Sendy
SENDY_ACTION_URL=https://sendy.todoconta.com/subscribe
SENDY_API_KEY=
# Lista nueva "Cuentas Claras - La guía" (doble opt-in). Campos personalizados con
# estos nombres EXACTOS: Whatsapp, Origen. El autoresponder del día 0 manda el PDF.
SENDY_GUIA_LIST_ID=
# La lista de prospectos del despacho (la misma de sicastro.com). Campos: Whatsapp, Regimen,
# Interes, RangoInterno, Origen
SENDY_DIAGNOSTICO_LIST_ID=

# SES
SES_REGION=us-east-1
SES_ACCESS_KEY_ID=
SES_SECRET_ACCESS_KEY=
CORREO_REMITENTE=avisos@sicastro.com
CORREO_DESPACHO=
