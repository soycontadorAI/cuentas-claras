---
/** La barra de arriba. En la portada las ligas son anclas; en las demás páginas llevan "/". */
interface Props { portada?: boolean }
const { portada = false } = Astro.props;
const a = (id: string) => (portada ? `#${id}` : `/#${id}`);
---
<header class="barra" id="barra">
  <div class="envoltura">
    <a class="marca" href="/" aria-label="Cuentas Claras, inicio">
      <svg class="billete" aria-hidden="true"><use href="#billete"/></svg>
      <span class="rot">Cuentas<br />Claras</span>
    </a>
    <nav class="nav" aria-label="Secciones">
      <a href={a('encuentras')}>Qué hay aquí</a>
      <a href={a('calcula')}>Calcula</a>
      <a href={a('preguntas')}>Preguntas</a>
      <a href={a('quien')}>Quién</a>
      <a href="/agendar">Consulta</a>
    </nav>
    <a class="btn" data-magnetico href={a('guia')}>La guía gratis</a>
  </div>
</header>

<style>
  .barra { position: sticky; top: env(safe-area-inset-top, 0px); z-index: 50; transition: background-color .3s, box-shadow .3s; }
  .barra:global(.fondo) { background: rgba(255, 246, 232, .94); backdrop-filter: blur(10px); -webkit-backdrop-filter: blur(10px); box-shadow: 0 1px 0 var(--cacao-12); }
  .envoltura { display: flex; align-items: center; gap: 24px; min-height: 72px; }
  .marca { display: inline-flex; align-items: center; gap: 10px; text-decoration: none; margin-right: auto; }
  .marca svg { transition: transform .6s var(--e-rebote); }
  .marca:hover svg { transform: rotate(-12deg) scale(1.06); }
  .marca .rot { font-size: 21px; line-height: .9; }
  .nav { display: flex; gap: 26px; font-weight: 600; font-size: 16px; }
  .nav a { text-decoration: none; position: relative; }
  .nav a::after { content: ""; position: absolute; left: 0; right: 0; bottom: -4px; height: 3px; background: var(--rosa); border-radius: 2px; transform: scaleX(0); transform-origin: left; transition: transform .35s var(--e-trazo); }
  .nav a:hover::after { transform: scaleX(1); }
  @media (max-width: 820px) { .nav { display: none; } .btn { min-height: 44px; padding: 0 16px; font-size: 14.5px; } }
</style>
