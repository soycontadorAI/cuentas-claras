---
import { CANAL, DESPACHO, PERSONA, conUtm } from '../lib/sitio';
---
<footer class="pie">
  <div class="envoltura">
    <div>
      <a class="marca" href="/"><svg class="billete" aria-hidden="true"><use href="#billete"/></svg><span class="rot">Cuentas<br />Claras</span></a>
      <p class="chico">Un canal de {DESPACHO.nombre}. Patrocina TodoConta. Los videos y la guía son orientación general: cada caso tiene sus detalles.</p>
    </div>
    <div>
      <h2>El canal</h2>
      <ul>
        <li><a href={CANAL.url} rel="noopener">YouTube</a></li>
        <li><a href={PERSONA.instagram} rel="noopener">Instagram</a></li>
        <li><a href="/#guia">La guía gratis</a></li>
        <li><a href="/agendar">Consulta 1:1</a></li>
      </ul>
    </div>
    <div>
      <h2>La casa</h2>
      <ul>
        <li><a href={conUtm(DESPACHO.url, 'landing', 'pie')} rel="noopener">El despacho</a></li>
        <li><a href={conUtm('https://todoconta.com', 'landing', 'pie')} rel="noopener">La app: TodoConta</a></li>
        <li><a href={conUtm('https://soycontador.ai', 'landing', 'pie')} rel="noopener">IA para contadores</a></li>
        <li><a href="/privacidad">Aviso de privacidad</a></li>
      </ul>
    </div>
  </div>
</footer>

<style>
  .pie { margin-top: clamp(40px, 6vw, 80px); border-top: var(--linea); background: var(--papel); }
  .envoltura { display: grid; grid-template-columns: minmax(0, 1.4fr) repeat(2, minmax(0, 1fr)); gap: 0; }
  .envoltura > div { padding: 28px 24px 28px 0; }
  .envoltura > div + div { padding-left: 24px; border-left: 1px solid var(--cacao-12); }
  .marca { display: inline-flex; align-items: center; gap: 10px; text-decoration: none; }
  .marca .billete { width: 32px; height: 32px; }
  .marca .rot { font-size: 18px; line-height: .9; }
  h2 { margin: 0 0 10px; font-size: 12.5px; font-weight: 800; letter-spacing: .12em; text-transform: uppercase; color: var(--cacao-70); line-height: 1.2; }
  ul { margin: 0; padding: 0; list-style: none; display: grid; gap: 2px; font-weight: 600; font-size: 15px; }
  a:not(.marca) { display: inline-block; padding-block: 4px; text-decoration: none; }
  a:not(.marca):hover { text-decoration: underline; text-decoration-color: var(--rosa); text-decoration-thickness: 2px; text-underline-offset: 4px; }
  .chico { margin: 12px 0 0; color: var(--cacao-70); font-size: 13.5px; max-width: 42ch; }
  @media (max-width: 760px) { .envoltura { grid-template-columns: 1fr 1fr; } .envoltura > :first-child { grid-column: 1 / -1; } .envoltura > div + div { border-left: 0; padding-left: 0; } }
</style>
