---
import { Image } from 'astro:assets';

import Barra from '../components/Barra.astro';
import Pie from '../components/Pie.astro';
import Base from '../layouts/Base.astro';

import stLupa from '../assets/stickers/lupa.png';
---
<Base titulo="Esta hoja no existe" noindex>
  <Barra />
  <main id="contenido" class="envoltura nada">
    <div class="cel hoja-unica">
      <span class="pestana rosa">404</span>
      <Image class="sticker" data-pega style="--g: 8deg" src={stLupa} alt="" width={110} height={110} />
      <h1 class="disp">Esta hoja <span class="resaltado" data-resalta>se arrancó.</span></h1>
      <p class="chica">La página que buscas no está, o cambió de lugar.</p>
      <div class="acciones"><a class="btn" data-magnetico href="/">Ir al inicio</a><a class="btn claro" href="/#guia">Pedir la guía</a></div>
    </div>
  </main>
  <Pie />
</Base>
<script>
  import { medir } from '../lib/medir';
  import { iniciar } from '../scripts/movimiento';

  iniciar();

  // Ligas rotas: qué ruta buscaron y, si el clic salió de una página nuestra, cuál es (así se
  // arregla la liga). Si vino de fuera, solo el dominio.
  let desde: string | undefined;
  try {
    const ref = new URL(document.referrer);
    desde = ref.hostname === location.hostname ? ref.pathname.slice(0, 120) : ref.hostname;
  } catch { /* sin referente */ }
  medir('pagina_no_encontrada', { ruta: location.pathname.slice(0, 120), desde });
</script>
<style>
  .nada { padding-block: clamp(56px, 9vw, 120px) 0; }
  .hoja-unica { max-width: 880px; margin-inline: auto; padding: clamp(28px, 5vw, 64px); box-shadow: var(--sombra-dura); }
  h1 { margin: 0; font-size: var(--t-h2); max-width: 12ch; }
  .chica { font-size: 1.15rem; margin-top: 18px; }
  .acciones { display: flex; flex-wrap: wrap; gap: 14px; margin-top: 32px; }
  @media (max-width: 560px) { .hoja-unica :global(.sticker) { width: 70px; top: -26px; } }
</style>
