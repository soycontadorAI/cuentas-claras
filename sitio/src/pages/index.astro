---
/**
 * La portada de Cuentas Claras (landing "libro mayor vivo", elegida el 2026-11-02; boceto en
 * design/landing/v2/4-libro-mayor-vivo.html). Presenta el canal y capta correos a cambio de la guía
 * gratis ("La guía"). No vende: los servicios mandan a sicastro.com con utm.
 *
 * Orden: portada con Israel y un solo CTA (la guía) → marquesina de preguntas → calculadora en su
 * propia celda (para que no compita con el CTA) → los tres cajones → serie, quién, guía,
 * preguntas y colaboraciones en celdas de libro mayor.
 */
import { Image, Picture } from 'astro:assets';

import Barra from '../components/Barra.astro';
import Pie from '../components/Pie.astro';
import Base from '../layouts/Base.astro';
import { MESES, PREGUNTAS, TRAE } from '../lib/guia';
import { canal, despacho, persona, preguntas, sitioWeb } from '../lib/schema';
import { CANAL, DESPACHO, conUtm, whatsappUrl } from '../lib/sitio';

import israelCruzado from '../assets/israel-cruzado.webp';
import israelDuda from '../assets/israel-duda.webp';
import stCalculadora from '../assets/stickers/calculadora.png';
import stCalendario from '../assets/stickers/calendario.png';
import stLupa from '../assets/stickers/lupa.png';
import stPregunta from '../assets/stickers/pregunta.png';

const TASAS = [10.88, 16, 21.36, 23.52, 30];
const TIRA = ['¿Qué es la constancia de situación fiscal?', '¿Me toca saldo a favor?', '¿Cómo saco mi e.firma?', 'Me llegó una carta del SAT', '¿Mi inversión en Sofipo cuenta?'];
const CIRCULO = 'M62 3 C 90 3, 99 18, 97 30 C 94 47, 24 51, 6 40 C -4 32, -2 6, 34 2 C 50 0, 70 1, 82 7';
---
<Base grafo={[sitioWeb(), despacho(), persona(), canal(), preguntas()]}>
  <Barra portada />

  <main id="contenido">
    <section class="portada">
      <div class="envoltura">
        <div class="marco-wrap">
          <div class="estampa" aria-hidden="true">
            <svg class="texto-circular" viewBox="0 0 118 118"><defs><path id="circ" d="M59 59 m-48 0 a48 48 0 1 1 96 0 a48 48 0 1 1 -96 0"/></defs><text><textPath href="#circ">un canal · nuevo cada semana · </textPath></text></svg>
            <div class="disco"><svg aria-hidden="true"><use href="#billete"/></svg></div>
          </div>
          <span class="nota n1" aria-hidden="true">¿Tengo que declarar si solo tengo sueldo?</span>
          <span class="nota rosa n2" aria-hidden="true">¿Mi inversión en Sofipo cuenta?</span>

          <div class="marco-portada">
            <div class="texto">
              <p class="etiqueta">Impuestos · Contabilidad · Finanzas personales</p>
              <h1 class="disp"><span class="linea"><span>El SAT y</span></span><span class="linea"><span>tu dinero,</span></span><span class="linea"><span><span class="resaltado" data-resalta>en orden.</span></span></span></h1>
              <p class="bajada">Tus obligaciones con el SAT explicadas paso a paso, tu declaración sin sorpresas y tus números claros.</p>
              <div class="acciones">
                <a class="btn" data-magnetico href="#guia">Quiero la guía</a>
                <a class="enlace-flecha" href={CANAL.url} rel="noopener"><svg width="28" height="20" aria-hidden="true"><use href="#yt"/></svg><span>Ver el canal</span></a>
              </div>
              <div class="datos" aria-label="Lo que es el canal">
                <div><b>Cada semana</b><span>un video nuevo</span></div>
                <div><b>Una duda</b><span>por video</span></div>
                <div><b>Gratis</b><span>el canal y la guía</span></div>
              </div>
            </div>
            <div class="foto-celda">
              <Picture class="israel-hero" src={israelCruzado} formats={['avif', 'webp']} quality={50} alt="Israel Castro, contador público, con los brazos cruzados" widths={[380, 540, 720]} sizes="(max-width: 900px) min(80vw, 380px), 540px" loading="eager" fetchpriority="high" />
            </div>
          </div>
        </div>

        <div class="tira" role="region" aria-label="Preguntas que se resuelven en el canal">
          <div class="tira-pista">
            {[0, 1].map((copia) => (
              <span aria-hidden={copia === 1 ? 'true' : undefined}>
                {TIRA.map((t) => (<>{t} <svg aria-hidden="true"><use href="#billete"/></svg> </>))}
              </span>
            ))}
          </div>
        </div>

        <div class="cel calc vivo" id="calcula">
          <span class="pestana">Pruébalo</span>
          <Image class="sticker" data-pega style="--g: 7deg" src={stCalculadora} alt="" width={76} height={94} />
          <div class="calc-grid">
            <div class="calc-izq">
              <h2 class="disp">¿Cuánto te regresa <span class="resaltado" data-resalta>una deducción?</span></h2>
              <p class="chica">Menos de lo que crees: cada peso que deduces te regresa lo que pagas de impuesto sobre él, no el peso completo. Muévele, no te pedimos nada.</p>
              <label class="que-es" for="deduce">Doctor, dentista, seguro de gastos médicos, lentes… lo que deduces en el año</label>
              <output class="cifra" id="monto" for="deduce">$20,000</output>
              <input id="deduce" type="range" min="1000" max="80000" step="1000" value="20000" aria-describedby="ayuda-calc" />
              <p class="que-es sube" id="tasas-t">Tu tasa más alta (sube con lo que ganas)</p>
              <div class="tasas" role="group" aria-labelledby="tasas-t">
                {TASAS.map((t) => <button type="button" data-tasa={t} aria-pressed={t === 21.36 ? 'true' : 'false'}>{t}%</button>)}
              </div>
            </div>
            <div class="calc-der">
              <div aria-live="polite">
                <div class="renglon-c"><span>Lo que deduces</span><i></i><b id="c-deduce">$20,000</b></div>
                <div class="renglon-c"><span>× tu tasa</span><i></i><b id="c-tasa">21.36%</b></div>
                <div class="te-regresa"><span>Te regresa, más o menos</span><b class="total" id="c-regresa">$4,272</b></div>
              </div>
              <p class="ayuda" id="ayuda-calc">Tasas de la tarifa anual del artículo 152 de la LISR. Tienen topes y requisitos: es un ejemplo, cada caso tiene sus detalles.</p>
            </div>
          </div>
        </div>

        <div class="cajones" id="encuentras">
          <div class="cajon" data-entra style="--i:0"><span class="pestana">SAT</span><h3>Tus trámites, sin perderte en el portal</h3><p>Paso a paso, con la pantalla real.</p><ul class="palomeo"><li>RFC y e.firma</li><li>Constancia de situación fiscal</li><li>Buzón tributario y cartas</li></ul></div>
          <div class="cajon" data-entra style="--i:1"><span class="pestana rosa">Tu declaración</span><h3>La anual, sin sorpresas</h3><p>Si estás obligado, qué deducir y cuánto te regresan de verdad.</p><ul class="palomeo"><li>Obligación</li><li>Deducciones personales</li><li>Saldos a favor</li></ul></div>
          <div class="cajon" data-entra style="--i:2"><span class="pestana cacao">Tus números</span><h3>Tu dinero, en claro</h3><p>Lo que entra, lo que sale y lo que te queda.</p><ul class="palomeo"><li>Ingresos extra</li><li>Finanzas sanas</li><li>Estados financieros básicos</li></ul></div>
        </div>

        <div class="bento">
          <div class="cel oscura s7 vivo" id="series">
            <span class="pestana">Cada semana</span>
            <Image class="sticker" data-pega style="--g: 8deg" src={stPregunta} alt="" width={100} height={88} />
            <h2 class="disp">Una duda, <span class="maiz">un video.</span></h2>
            <p class="chica">Como una consultoría, cada semana y sin costo. Cada video arranca con la pregunta tal cual, y la contesta completa.</p>
            <p class="globo" data-entra><small>La primera serie</small>“Si solo tengo sueldo, ¿tengo que declarar?”</p>
            <ol class="videos">
              <li class="video" data-entra data-palomea style="--i:0"><span class="caja"><svg viewBox="0 0 40 40" aria-hidden="true"><path pathLength="1" d="M6 21 L16 31 L35 8"/></svg></span><div><h3>Cuándo sí estás obligado (y cuándo no)</h3><p>El monto que lo cambia todo, dos patrones a la vez y qué pasa si te sale a pagar.</p></div></li>
              <li class="video" data-entra data-palomea style="--i:1"><span class="caja"><svg viewBox="0 0 40 40" aria-hidden="true"><path pathLength="1" d="M6 21 L16 31 L35 8"/></svg></span><div><h3>Deducciones: cuánto te regresan de verdad</h3><p>Cada peso que deduces no te regresa un peso. Lo hacemos con números.</p></div></li>
              <li class="video" data-entra data-palomea style="--i:2"><span class="caja"><svg viewBox="0 0 40 40" aria-hidden="true"><path pathLength="1" d="M6 21 L16 31 L35 8"/></svg></span><div><h3>Sueldo y algo más</h3><p>Intereses, Sofipo, casa de bolsa o una herencia: cuándo se suman y cuándo no.</p></div></li>
            </ol>
            <div class="venen"><span>Lo que viene:</span><span>Aguinaldo</span><span style="--c: var(--rosa)">Tus inversiones</span><span style="--c: var(--crema)">Tu anual</span></div>
            <a class="mas-yt" href={CANAL.url} rel="noopener">Ver el canal en YouTube</a>
          </div>

          <div class="cel israel s5 vivo" id="quien">
            <span class="pestana rosa">Quién está detrás</span>
            <div>
              <blockquote>Aquí resuelvo las dudas que más me traen mis clientes, para que tú las resuelvas sin pagar una consulta.</blockquote>
              <p class="firma"><strong>Israel Castro</strong>, contador público y socio de {DESPACHO.nombre}, el despacho familiar.</p>
            </div>
            <div class="pie-celda">
              <Image src={israelDuda} alt="Israel Castro pensando, con la mano en la barbilla" widths={[250, 380, 500]} sizes="250px" />
              <div class="manos">
                <span class="nota papel" data-pega style="--giro: 3deg">¿Tu caso no es tan sencillo? <a href="/agendar">Agenda una consulta 1:1</a></span>
                <p>Aprende con nosotros… <span class="rot">o déjalo en nuestras manos.</span></p>
                <a class="btn claro" data-magnetico href={conUtm(DESPACHO.url, 'landing', 'quien')} rel="noopener">Ir al despacho</a>
              </div>
            </div>
          </div>

          <div class="cel s7 vivo" id="guia">
            <span class="pestana cacao">Gratis</span>
            <Image class="sticker" data-pega style="--g: -8deg" src={stCalendario} alt="" width={92} height={96} />
            <h2 class="disp">Qué hacer con el SAT, <span class="resaltado" data-resalta>mes por mes.</span></h2>
            <p class="chica">Una guía gratis para no fallar con el SAT, para pegar en el refri.</p>
            <div class="hoja">
              <ol class="meses" data-palomea aria-label="Vista previa de la guía: el calendario de 12 meses">
                {MESES.map((m) => (
                  <li class:list={{ clave: m.clave }}>
                    <b>{m.corto}</b>{m.toca}
                    {m.clave && <svg class="circulo" viewBox="0 0 100 50" preserveAspectRatio="none" aria-hidden="true"><path pathLength="1" d={CIRCULO}/></svg>}
                  </li>
                ))}
              </ol>
            </div>
            <p class="leyenda"><i></i>Los meses que no se mueven</p>
            <ul class="trae-l" aria-label="Lo que trae la guía">
              {TRAE.map((t) => <li>{t.titulo}</li>)}
            </ul>
          </div>

          <div class="cel oscura s5 vivo">
            <form id="form-guia" novalidate>
              <h3 class="disp">Te la mandamos <span class="rot">gratis</span></h3>
              <p class="chica">Llega a tu correo en un minuto. Si dejas tu WhatsApp, te avisamos cuando salga cada serie.</p>
              <div class="campos">
                <div class="campo"><label for="nombre">Tu nombre</label><input id="nombre" name="nombre" type="text" autocomplete="given-name" placeholder="¿Cómo te llamas?" required maxlength="80" /></div>
                <div class="campo"><label for="correo">Tu correo</label><input id="correo" name="correo" type="email" autocomplete="email" placeholder="tu@correo.com" required maxlength="200" /></div>
                <div class="campo"><label for="whatsapp">WhatsApp <small>(opcional)</small></label><input id="whatsapp" name="whatsapp" type="tel" inputmode="tel" autocomplete="tel" placeholder="10 dígitos" maxlength="20" /></div>
                <div class="hp" aria-hidden="true"><label for="sitio">No llenar</label><input id="sitio" name="sitio" type="text" tabindex="-1" autocomplete="off" /></div>
                <button class="btn rosa ancho" data-magnetico type="submit">Mándamela</button>
                <p class="error" data-error role="alert" hidden></p>
              </div>
              <p class="fino">Sin spam; te das de baja cuando quieras. <a href="/privacidad">Aviso de privacidad</a>.</p>
            </form>
            <div class="listo" id="listo-guia" tabindex="-1" hidden>
              <span class="rot">¡Listo!</span>
              <p>Revisa tu correo.</p>
            </div>
          </div>

          <div class="cel s8 vivo" id="preguntas">
            <span class="pestana rosa">Sin rodeos</span>
            <Image class="sticker" data-pega style="--g: 6deg" src={stLupa} alt="" width={84} height={84} />
            <h2 class="disp">Lo que más <span class="resaltado" data-resalta>me preguntan.</span></h2>
            <div class="preguntas">
              {PREGUNTAS.map((p, i) => (
                <details class="pregunta" open={i === 0}>
                  <summary>{p.pregunta}<span class="mas" aria-hidden="true"></span></summary>
                  <p>{p.respuesta}</p>
                </details>
              ))}
            </div>
          </div>

          <div class="cel colabora s4 vivo" id="colabora">
            <span class="pestana">Marcas y creadores</span>
            <div>
              <h2 class="disp">¿Hacemos algo juntos?</h2>
              <p class="chica">Videos en colaboración, una charla para tu equipo o tu comunidad.</p>
            </div>
            <ul><li class="chip"><i style="--c: var(--rosa)"></i>Colaboraciones</li><li class="chip"><i></i>Charlas</li><li class="chip"><i style="--c: var(--cacao)"></i>Prensa</li></ul>
            <a class="btn" data-magnetico href={whatsappUrl('Hola, vengo de Cuentas Claras por una colaboración.')} rel="noopener">Escríbenos</a>
          </div>
        </div>
      </div>
    </section>
  </main>

  <Pie />
</Base>

<script>
  import { iniciarCalculadora } from '../scripts/calculadora';
  import { iniciarGuia } from '../scripts/guia';
  import { iniciar } from '../scripts/movimiento';

  iniciar();
  iniciarCalculadora();
  iniciarGuia();
</script>

<style>
  /* La estructura es de libro (celdas de filete, cifras tabulares). El juego vive en los bordes:
     pestañas, notas, el sello, calcomanías, el plumón y el movimiento ligado al scroll.
     Dentro de cada celda todo sigue quieto y legible. */
  /* ---------- Portada: dos celdas, texto y Israel ---------- */
  .portada { padding-block: clamp(20px, 3vw, 40px) 0; }
  .marco-wrap { position: relative; }
  .marco-portada { box-shadow: var(--sombra-dura); display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.05fr); background: var(--papel); border: var(--linea); border-radius: var(--radio-s); overflow: hidden; }
  .texto { padding: clamp(24px, 4vw, 52px); }
  .foto-celda { display: flex; align-items: flex-end; justify-content: center; min-height: 420px; overflow: hidden; border-left: var(--linea); background: var(--crema); }
  h1 { margin: 22px 0 0; font-size: clamp(2.8rem, 1.2rem + 4.8vw, 5.4rem); line-height: .92; letter-spacing: -.03em; }
  h1 .linea { display: block; overflow: hidden; padding: .02em .5em .1em 0; margin: -.02em -.5em -.1em 0; }
  h1 .linea > span { display: inline-block; animation: subir 1s var(--e-salida) both; }
  h1 .linea:nth-child(2) > span { animation-delay: .12s; }
  h1 .linea:nth-child(3) > span { animation-delay: .24s; }
  @keyframes subir { from { transform: translateY(112%); } }
  .bajada { margin: 26px 0 0; max-width: 32ch; font-size: clamp(1.1rem, 1rem + .4vw, 1.3rem); line-height: 1.45; color: var(--cacao-70); }
  .acciones { display: flex; flex-wrap: wrap; gap: 14px 24px; align-items: center; margin-top: 30px; }
  .datos { display: grid; grid-template-columns: repeat(3, auto); justify-content: start; gap: 0; margin-top: clamp(30px, 5vw, 60px); border-top: 1px solid var(--cacao-12); }
  .datos div { padding: 14px 24px 0 0; margin-right: 24px; border-right: 1px solid var(--cacao-12); }
  .datos div:last-child { border: 0; }
  .datos b { display: block; font-size: 1.25rem; font-weight: 800; font-variation-settings: "wdth" 92; line-height: 1.1; }
  .datos span { font-size: 13px; color: var(--cacao-70); }
  .foto-celda :global(.israel-hero) { width: min(92%, 540px); height: auto; margin-bottom: -1px; filter: drop-shadow(0 22px 24px rgba(59, 36, 24, .24)); animation: sube-foto 1.1s var(--e-salida) .25s both; }
  @keyframes sube-foto { from { translate: 0 60px; opacity: 0; } }
  @media (max-width: 900px) {
    .marco-portada { grid-template-columns: 1fr; }
    .foto-celda { border-left: 0; border-top: var(--linea); min-height: 0; }
    .foto-celda :global(.israel-hero) { width: min(80%, 380px); }
  }
  @media (max-width: 520px) { .datos { grid-template-columns: 1fr 1fr; } .datos div:nth-child(2) { border: 0; } }

  /* Sello y notas de la portada */
  .estampa { position: absolute; z-index: 5; top: -44px; right: 14px; width: 108px; height: 108px; animation: aparecer .9s var(--e-rebote) .7s both; }
  .estampa .disco { position: absolute; inset: 14px; border-radius: 50%; background: var(--maiz); display: grid; place-items: center; box-shadow: inset 0 0 0 1px var(--cacao); }
  .estampa .disco svg { width: 50px; height: 50px; }
  .texto-circular { position: absolute; inset: 0; animation: girar 22s linear infinite; }
  .texto-circular text { font: 800 12.5px var(--display); letter-spacing: .18em; fill: var(--cacao); text-transform: uppercase; }
  @keyframes aparecer { from { transform: scale(0) rotate(-90deg); } }
  @keyframes girar { to { transform: rotate(360deg); } }
  .nota.n1, .nota.n2 { display: none; }
  @media (min-width: 1240px) {
    .nota.n1, .nota.n2 { display: block; z-index: 4; width: 176px; animation: pegar .8s var(--e-rebote) .5s both; }
    .nota.n1 { top: 86px; left: calc(48.8% + 22px); --giro: -6deg; }
    .nota.n2 { top: 44%; right: 20px; --giro: 5deg; animation-delay: .65s; }
  }
  @keyframes pegar { from { translate: 0 30px; scale: .8; opacity: 0; } }
  .nota a { color: inherit; text-decoration-color: var(--rosa); text-decoration-thickness: 2px; }
  @media (max-width: 560px) { .texto { padding-top: 58px; } .estampa { width: 84px; height: 84px; top: -34px; right: 6px; } .estampa .disco svg { width: 38px; height: 38px; } }

  /* ---------- La tira de preguntas: una cinta de contabilidad ---------- */
  .tira { margin-top: 36px; border: var(--linea); border-radius: var(--radio-s); background: var(--papel); overflow: hidden; padding-block: 12px; }
  .tira-pista { display: flex; gap: 28px; width: max-content; animation: correr 46s linear infinite; }
  .tira:hover .tira-pista { animation-play-state: paused; }
  .tira-pista > span { display: inline-flex; align-items: center; gap: 28px; white-space: nowrap; font-weight: 800; font-size: 1.05rem; font-variation-settings: "wdth" 92; }
  .tira-pista svg { width: 26px; height: 26px; flex: none; }
  @keyframes correr { to { transform: translateX(-50%); } }

  /* ---------- La calculadora, en su propia celda ---------- */
  .calc { margin-top: 54px; padding: 0; }
  .calc-grid { display: grid; grid-template-columns: minmax(0, 1.05fr) minmax(0, .95fr); }
  .calc-izq { padding: clamp(26px, 4vw, 52px); }
  .calc h2 { max-width: 17ch; font-size: clamp(2rem, 1.3rem + 2.8vw, 3.6rem); }
  .calc-izq .chica { margin-bottom: 26px; }
  .calc-der { padding: clamp(26px, 4vw, 52px); padding-top: clamp(64px, 6vw, 84px); border-left: var(--linea); border-radius: 0 5px 5px 0; display: flex; flex-direction: column; justify-content: center; background: var(--crema); }
  .calc :global(.sticker) { right: 30px; }
  .que-es { display: block; margin: 0 0 8px; font-size: 14.5px; color: var(--cacao-70); max-width: 40ch; }
  .que-es.sube { margin-top: 14px; }
  .cifra { display: block; margin: 20px 0 6px; font-weight: 800; font-size: clamp(2.6rem, 1.8rem + 2.4vw, 3.8rem); line-height: 1; letter-spacing: -.03em; font-variant-numeric: tabular-nums; font-variation-settings: "wdth" 92; }
  input[type="range"] { width: 100%; height: 30px; background: transparent; -webkit-appearance: none; appearance: none; cursor: pointer; }
  input[type="range"]::-webkit-slider-runnable-track { height: 2px; background: linear-gradient(90deg, var(--cacao) var(--p, 25%), var(--cacao-12) var(--p, 25%)); }
  input[type="range"]::-moz-range-track { height: 2px; background: var(--cacao-12); }
  input[type="range"]::-moz-range-progress { height: 2px; background: var(--cacao); }
  input[type="range"]::-webkit-slider-thumb { -webkit-appearance: none; width: 22px; height: 22px; margin-top: -10px; border-radius: 50%; background: var(--maiz); border: 2px solid var(--cacao); transition: transform .3s var(--e-rebote); }
  input[type="range"]::-moz-range-thumb { width: 18px; height: 18px; border-radius: 50%; background: var(--maiz); border: 2px solid var(--cacao); }
  input[type="range"]:hover::-webkit-slider-thumb { transform: scale(1.14) rotate(-8deg); }
  .tasas { align-self: flex-start; display: inline-flex; flex-wrap: wrap; margin-top: 8px; border: var(--linea); border-radius: var(--radio-s); overflow: hidden; background: var(--papel); }
  .tasas button { min-height: 44px; padding: 0 14px; border: 0; border-right: 1px solid var(--cacao); background: transparent; color: var(--cacao); font: 700 14.5px var(--display); font-variant-numeric: tabular-nums; cursor: pointer; transition: background-color .2s, transform .35s var(--e-rebote); }
  .tasas button:last-child { border-right: 0; }
  .tasas button:hover { background: var(--maiz); transform: rotate(-3deg) scale(1.06); }
  .tasas button[aria-pressed="true"] { background: var(--cacao); color: var(--crema); }
  .renglon-c { display: flex; align-items: baseline; gap: 10px; font-weight: 600; font-variant-numeric: tabular-nums; }
