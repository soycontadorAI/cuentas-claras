---
/** La barra de arriba. En la portada las ligas son anclas; en las demás páginas llevan "/". */
interface Props { portada?: boolean }
const { portada = false } = Astro.props;
const a = (id: string) => (portada ? `#${id}` : `/#${id}`);
---
<header class="barra" id="barra">
  <div class="envoltura">
    <a class="marca" href="/" aria-label="Cuentas Claras, inicio">
      <svg class="billete" aria-hidden="true"><use href="#billete"/></svg>
      <span class="rot">Cuentas<br />Claras</span>
    </a>
    <nav class="nav" aria-label="Secciones">
      <a href={a('calcula')}>Calcula</a>
      <a href={a('encuentras')}>Qué hay aquí</a>
      <a href={a('series')}>Series</a>
      <a href={a('preguntas')}>Preguntas</a>
      <a href={a('quien')}>Quién</a>
      <a href="/agendar">Consulta</a>
    </nav>
    <a class="btn" data-magnetico href={a('guia')}>La guía gratis</a>
  </div>
</header>

<style>
  /* La barra de un libro de cuentas: filete abajo, ligas en celdas y, con scroll, una raya rosa que avanza con la lectura */
  .barra { position: sticky; top: env(safe-area-inset-top, 0px); z-index: 50; background: rgba(255, 246, 232, .94); backdrop-filter: blur(10px); -webkit-backdrop-filter: blur(10px); border-bottom: var(--linea); }
  .envoltura { display: flex; align-items: center; gap: 28px; min-height: 64px; }
  .marca { display: inline-flex; align-items: center; gap: 10px; text-decoration: none; margin-right: auto; }
  .marca .billete { width: 32px; height: 32px; transition: transform .6s var(--e-rebote); }
  .marca:hover .billete { transform: rotate(-12deg) scale(1.06); }
  .marca .rot { font-size: 18px; line-height: .9; }
  .nav { display: flex; gap: 0; font-size: 14.5px; font-weight: 700; }
  .nav a { text-decoration: none; padding: 22px 16px; border-left: 1px solid var(--cacao-12); transition: background-color .2s; }
  .nav a:last-child { border-right: 1px solid var(--cacao-12); }
  .nav a:hover { background: var(--maiz); }
  .btn { min-height: 40px; padding: 0 18px; font-size: 14px; }
  @media (max-width: 1060px) { .nav a:nth-child(n+4):not(:last-child) { display: none; } }
  @media (max-width: 900px) { .nav { display: none; } .btn { min-height: 44px; } }
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .barra::after { content: ""; position: absolute; left: 0; right: 0; bottom: -1px; height: 3px; background: var(--rosa); transform-origin: left; animation: avance linear both; animation-timeline: scroll(root); }
      @keyframes avance { from { transform: scaleX(0); } to { transform: scaleX(1); } }
    }
  }
</style>
